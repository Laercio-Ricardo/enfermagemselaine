# GEMINI_API_KEY: Required for Gemini AI API calls on server side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Required for direct client-side calls on static hosting (e.g. Netlify/Vercel)
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
